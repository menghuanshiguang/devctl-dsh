{
  "name": "devctl-dsh",
  "version": "1.4.0",
  "private": true,
  "description": "Drive a DSH instance from another device over a token-authenticated TCP control port - the DSH half of the devctl family.",
  "keywords": [
    "dsh",
    "devctl",
    "remote-control",
    "cli",
    "deepseek"
  ],
  "homepage": "https://github.com/menghuanshiguang/devctl-dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/devctl-dsh.git"
  },
  "author": "menghuanshiguang",
  "license": "MIT",
  "type": "module",
  "files": [
    "index.js",
    "client.js",
    "remote-web.js",
    "qr.js",
    "cordis.patch.yml",
    "cli",
    "clients",
    "docs",
    "host-patch",
    "AndroidManifest.xml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cli/dshctl.py": "./cli/dshctl.py",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": "0.1.5-rc.3 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2",
      "dshReleases": {
        "0.1.5-rc.3": "compatible",
        "0.1.7-rc.2": "compatible",
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      },
      "dshOperations": {
        "0.1.5-rc.3": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "unknown" },
        "0.1.7-rc.2": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "unknown" },
        "0.2.0-rc.1": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "unknown" },
        "0.2.0-rc.2": { "install": "passed", "start": "passed", "uninstall": "passed", "rollback": "unknown" }
      }
    }
  }
}

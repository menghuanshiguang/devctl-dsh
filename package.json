{
  "name": "devctl-dsh",
  "version": "1.2.0",
  "private": true,
  "description": "Drive a DSH instance from another device over a token-authenticated TCP control port - the DSH half of the devctl family.",
  "keywords": [
    "dsh",
    "devctl",
    "remote-control",
    "cli",
    "deepseek"
  ],
  "homepage": "https://github.com/menghuanshiguang/devctl-dsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/devctl-dsh.git"
  },
  "author": "menghuanshiguang",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cli/dshctl.py": "./cli/dshctl.py",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
